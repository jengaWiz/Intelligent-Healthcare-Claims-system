# Local PostgreSQL (supply your own credentials).
DATABASE_URL=
# Provider keys are required only when the selected integration starts.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_MODEL=prebuilt-layout
LLM_PROVIDER=google
LLM_MODEL=
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Leave empty until the auth ticket supplies protected API/session handling.
API_AUTH_TOKEN=
ALLOWED_ORIGINS=[]
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
EXTRACTION_CONFIDENCE_THRESHOLD=0.8
PROVIDER_TIMEOUT_SECONDS=30
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20
WORKER_POLL_SECONDS=1
